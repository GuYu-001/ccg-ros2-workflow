{
  "name": "ccg-ros2-workflow",
  "version": "3.7.2-ros2.0",
  "description": "ROS2 Multi-Model Collaborative Development Workflow - Codex (Low-level Control) + Antigravity (Upper-layer Application) + Claude (Orchestration)",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "author": {
    "name": "CCG Contributors"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuYu-001/ccg-ros2-workflow.git"
  },
  "homepage": "https://github.com/GuYu-001/ccg-ros2-workflow#readme",
  "bugs": {
    "url": "https://github.com/GuYu-001/ccg-ros2-workflow/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ros2",
    "humble",
    "robotics",
    "claude",
    "codex",
    "antigravity",
    "gemini",
    "multi-model",
    "ai",
    "collaboration",
    "cli",
    "workflow"
  ],
  "bin": {
    "ccg-ros2-workflow": "bin/ccg.mjs"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "bin/ccg.mjs",
    "dist",
    "templates/commands/",
    "templates/commands-legacy/",
    "templates/engine/",
    "templates/hooks/",
    "templates/spec/",
    "templates/codex/",
    "templates/prompts/codex/",
    "templates/prompts/gemini/analyzer.md",
    "templates/prompts/gemini/architect.md",
    "templates/prompts/gemini/builder.md",
    "templates/prompts/gemini/debugger.md",
    "templates/prompts/gemini/frontend.md",
    "templates/prompts/gemini/optimizer.md",
    "templates/prompts/gemini/reviewer.md",
    "templates/prompts/gemini/tester.md",
    "templates/prompts/claude/",
    "templates/prompts/antigravity/",
    "templates/prompts/grok/",
    "templates/prompts/kimi/",
    "templates/prompts/opencode/",
    "templates/output-styles/",
    "templates/skills/SKILL.md",
    "templates/skills/run_skill.js",
    "templates/skills/orchestration/",
    "templates/skills/scrapling/",
    "templates/skills/tools/",
    "templates/skills/domains/ai/",
    "templates/skills/domains/architecture/",
    "templates/skills/domains/data-engineering/",
    "templates/skills/domains/development/",
    "templates/skills/domains/devops/",
    "templates/skills/domains/infrastructure/",
    "templates/skills/domains/mobile/",
    "templates/skills/domains/orchestration/",
    "templates/skills/domains/ros2-upper-app/",
    "templates/skills/domains/ros2-perception/",
    "templates/skills/domains/ros2-control/",
    "templates/skills/domains/ros2-navigation/",
    "templates/skills/domains/ros2-manipulation/",
    "templates/skills/domains/ros2-hardware/",
    "templates/rules/"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "unbuild",
    "start": "node bin/ccg.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "ansis": "^4.1.0",
    "cac": "^6.7.14",
    "fs-extra": "^11.3.2",
    "i18next": "^25.5.2",
    "i18next-fs-backend": "^2.6.9",
    "inquirer": "^12.9.6",
    "ora": "^9.0.0",
    "pathe": "^2.0.3",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "unbuild": "^3.6.1",
    "vitepress": "^1.6.4",
    "vitest": "^3.1.1"
  }
}
